# ─────────────────────────────────────────────────────────────
# Cyoda TMS — environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────

# ============ CYODA CONFIGURATION ============
# Get M2M credentials from Cyoda AI Studio
CYODA_HOST=your-instance.eu.cyoda.net
CYODA_CLIENT_ID=your-client-id
CYODA_CLIENT_SECRET=your-client-secret

# ============ WORKFLOW IMPORT (Optional) ============
# If you need to import workflows using user authentication, set these:
# WORKFLOW_USERNAME=your-username
# WORKFLOW_PASSWORD=your-password
# Otherwise, M2M credentials (above) will be used if available

# ============ CUCUMBER E2E TESTING (Optional) ============
# For running Cucumber E2E tests with a live Cyoda instance:
# - Ensure the CYODA_HOST, CYODA_CLIENT_ID, CYODA_CLIENT_SECRET variables above are set
# - Run: ./gradlew :apps:backend:cucumberTest
# - Test configuration is in apps/backend/src/test/resources/application-cucumber.yaml
# - Default test host: localhost:8443 (for local Cyoda development)

# ============ USER CREDENTIALS ============
# Users are defined in apps/backend/src/main/resources/users-seed.yml.
# Edit that file to add/remove users. Passwords must be bcrypt hashes — never plaintext.
# Generate a bcrypt hash: ./scripts/hash-password.sh <your-password>
#
# To override the seed file path (e.g. vault-mounted secrets in production):
# APP_USERS_SEED_FILE=/path/to/custom-seed.yml

# ============ APPLICATION CONFIGURATION ============
# JWT signing secret — used to sign and verify auth tokens (HMAC-SHA256).
# Must be at least 32 characters. Generate a strong random value for production:
#   openssl rand -base64 32
# Never reuse the dev default in production — changing this secret invalidates all active sessions.
APP_AUTH_SECRET=

# Set to false only for local HTTP development (no TLS). Must be true in production.
APP_AUTH_SECURE_COOKIE=false

# Server port
SERVER_PORT=8080

# Spring profiles (dev, test, prod)
SPRING_PROFILES_ACTIVE=default

# ============ CORS CONFIGURATION ============
# Allowed origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============ LOGGING ============
# Log level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# ============ GRPC CONFIGURATION ============
# gRPC settings (usually auto-configured from CYODA_HOST)
GRPC_ADDRESS=grpc-${CYODA_HOST}
GRPC_PORT=443

# ============ THREAD POOLS ============
PROCESSOR_THREAD_POOL=20
CRITERIA_THREAD_POOL=20
CONTROL_THREAD_POOL=3

# ============ SSL CONFIGURATION ============
# For production, set to false
SSL_TRUST_ALL=false

# ============ FEATURE FLAGS ============
# Include default operations for testing
INCLUDE_DEFAULT_OPERATIONS=false

# ============ FRONTEND ============
# For development with Vite proxy, use relative path /api
# For production, use full URL if backend is on different host
VITE_API_URL=/api
